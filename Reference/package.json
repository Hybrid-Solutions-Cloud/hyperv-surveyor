{
  "name": "hyperv-surveyor",
  "version": "1.0.0",
  "private": true,
  "description": "Hyper-V Surveyor - bidirectional sizing tool for Windows Server 2025 Hyper-V clusters (SAN / S2D / Hybrid)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/bundle-single.mjs",
    "preview": "vite preview",
