<mxfile host="Electron" version="31.1.8">
  <diagram name="Hyper-V Configurator | Overall journey">
    <mxGraphModel dx="1120" dy="1320" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1120" pageHeight="1320">
