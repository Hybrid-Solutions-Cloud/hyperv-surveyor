        </mxCell>
        <mxCell id="inventory" value="&lt;b&gt;Record exact component inventory&lt;/b&gt;&lt;br&gt;Names, OS/product versions, CPU/RAM/disks, IPs&lt;br&gt;Create infrastructure? Configure guest?&lt;br&gt;Install products? Configure/integrate products?" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=14;fontSize=17;fontFamily=Arial;strokeWidth=2;fillColor=#eaf3fb;strokeColor=#547da5;" vertex="1" parent="1">
          <mxGeometry x="290" y="600" width="540" height="100" as="geometry" />
        </mxCell>
        <mxCell id="ha" value="&lt;b&gt;Define availability independently&lt;/b&gt;&lt;br&gt;VMM service + SQL + library&lt;br&gt;SCOM management + databases + auxiliary recovery&lt;br&gt;WAC topology • infrastructure HA • site DR" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=14;fontSize=17;fontFamily=Arial;strokeWidth=2;fillColor=#fff3d7;strokeColor=#bb8b32;" vertex="1" parent="1">
