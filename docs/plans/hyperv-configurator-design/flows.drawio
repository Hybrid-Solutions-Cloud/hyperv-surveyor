  <diagram name="SDN | Design and setup">
    <mxGraphModel grid="1" page="1" pageWidth="1120" pageHeight="1410">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="&lt;b&gt;SDN | Design and setup path&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:16px&quot;&gt;Proposed v0.2.0 • Optional services, explicit ownership, version-qualified setup&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=28;fontColor=#123557;" vertex="1" parent="1">
          <mxGeometry x="20" y="10" width="1080" height="80" as="geometry" />
        </mxCell>
        <mxCell id="start" value="&lt;b&gt;SDN scope&lt;/b&gt;&lt;br&gt;None • use existing • deploy new • expand&lt;br&gt;Design only • setup handoff • qualified automation" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;fontSize=17;fontFamily=Arial;strokeWidth=2;fillColor=#eaf3fb;strokeColor=#547da5;" vertex="1" parent="1">
          <mxGeometry x="340" y="115" width="440" height="90" as="geometry" />
        </mxCell>
        <mxCell id="features" value="&lt;b&gt;Select required capabilities&lt;/b&gt;&lt;br&gt;Tenant virtual networks and isolation • network policies&lt;br&gt;Load balancing / NAT • routed or tunnel connectivity&lt;br&gt;Derive components from the selected version profile" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;fontSize=17;fontFamily=Arial;strokeWidth=2;fillColor=#eaf3fb;strokeColor=#547da5;" vertex="1" parent="1">
          <mxGeometry x="280" y="255" width="560" height="105" as="geometry" />
        </mxCell>
        <mxCell id="authority" value="&lt;b&gt;Choose controller architecture and setup owner&lt;/b&gt;&lt;br&gt;Service Fabric / controller VMs or supported WS2025 host role&lt;br&gt;VMM or qualified PowerShell tooling; one writer per resource" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;fontSize=17;fontFamily=Arial;strokeWidth=2;fillColor=#eaf3fb;strokeColor=#547da5;" vertex="1" parent="1">
          <mxGeometry x="280" y="410" width="560" height="90" as="geometry" />
        </mxCell>
        <mxCell id="vmm" value="&lt;b&gt;VMM setup&lt;/b&gt;&lt;br&gt;Fabric integration, profiles/templates&lt;br&gt;Controller service registration&lt;br&gt;OS / VMM / architecture compatibility" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;fontSize=17;fontFamily=Arial;strokeWidth=2;fillColor=#eaf3fb;strokeColor=#547da5;" vertex="1" parent="1">
          <mxGeometry x="30" y="565" width="330" height="105" as="geometry" />
        </mxCell>
        <mxCell id="scripts" value="&lt;b&gt;PowerShell setup&lt;/b&gt;&lt;br&gt;Versioned scripts / SDN Express&lt;br&gt;Controller-specific deployment profile&lt;br&gt;Runner and lifecycle ownership" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;fontSize=17;fontFamily=Arial;strokeWidth=2;fillColor=#eaf3fb;strokeColor=#547da5;" vertex="1" parent="1">
          <mxGeometry x="395" y="565" width="330" height="105" as="geometry" />
        </mxCell>
        <mxCell id="existing" value="&lt;b&gt;Existing SDN&lt;/b&gt;&lt;br&gt;Controller and resource references&lt;br&gt;Preserve shared services&lt;br&gt;Requested additions only" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;fontSize=17;fontFamily=Arial;strokeWidth=2;fillColor=#eaf3fb;strokeColor=#547da5;" vertex="1" parent="1">
          <mxGeometry x="760" y="565" width="330" height="105" as="geometry" />
        </mxCell>
        <mxCell id="inputs" value="&lt;b&gt;Complete design and prerequisites&lt;/b&gt;&lt;br&gt;Underlay VLANs / routing / MTU • HNV / VIP address pools&lt;br&gt;BGP peers / ASNs • tenant networks / policy&lt;br&gt;Controller endpoint / certificates • SLB / gateway placement&lt;br&gt;Capacity, availability, licensing and physical-network owner" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;fontSize=17;fontFamily=Arial;strokeWidth=2;fillColor=#eaf3fb;strokeColor=#547da5;" vertex="1" parent="1">
          <mxGeometry x="280" y="740" width="560" height="130" as="geometry" />
        </mxCell>
        <mxCell id="gate" value="&lt;b&gt;Check setup readiness&lt;/b&gt;&lt;br&gt;Feature dependencies, support and complete inputs&lt;br&gt;Qualified adapter? No → export a marked design / manual handoff" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;fontSize=17;fontFamily=Arial;strokeWidth=2;fillColor=#fff3d7;strokeColor=#547da5;" vertex="1" parent="1">
          <mxGeometry x="280" y="930" width="560" height="95" as="geometry" />
        </mxCell>
        <mxCell id="setup" value="&lt;b&gt;Ordered setup plan&lt;/b&gt;&lt;br&gt;Prepare underlay, hosts, identity and certificates&lt;br&gt;Deploy/register NC → host networking&lt;br&gt;Required SLB/MUX and gateways → tenant services/policies&lt;br&gt;OME appliance remains a separate manual task" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;fontSize=17;fontFamily=Arial;strokeWidth=2;fillColor=#eaf3fb;strokeColor=#547da5;" vertex="1" parent="1">
