        </mxCell>
        <mxCell id="cluster" value="&lt;b&gt;Cluster and SDN design&lt;/b&gt;&lt;br&gt;&lt;br&gt;Sites, hardware, storage and network authority&lt;br&gt;Bare metal / prepared / existing hosts&lt;br&gt;VMM or toolkit setup handoff&lt;br&gt;Optional SDN: controller, SLB and gateways" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=14;fontSize=17;fontFamily=Arial;strokeWidth=2;fillColor=#eaf3fb;strokeColor=#547da5;" vertex="1" parent="1">
