        <mxCell id="scope" value="&lt;b&gt;Choose scope and lifecycle&lt;/b&gt;&lt;br&gt;Management only • cluster only • both&lt;br&gt;New • existing • adoption • expansion" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=14;fontSize=17;fontFamily=Arial;strokeWidth=2;fillColor=#eaf3fb;strokeColor=#547da5;" vertex="1" parent="1">
          <mxGeometry x="350" y="250" width="420" height="90" as="geometry" />
