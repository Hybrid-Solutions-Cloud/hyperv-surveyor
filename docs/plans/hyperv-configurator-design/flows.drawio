  <diagram name="Cluster deployment | Ownership and handoff">
    <mxGraphModel dx="1120" dy="1320" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1120" pageHeight="1320">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="&lt;b&gt;Cluster deployment | Ownership and handoff&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:16px&quot;&gt;Design-only collection is a complete outcome; automated execution has additional prerequisites&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=28;fontColor=#123557;" vertex="1" parent="1">
          <mxGeometry x="20" y="10" width="1080" height="85" as="geometry" />
        </mxCell>
        <mxCell id="intent" value="&lt;b&gt;Select intent and starting state&lt;/b&gt;&lt;br&gt;New / adopt / expand / reimage&lt;br&gt;Bare metal / OS ready / Hyper-V ready / existing cluster" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=14;fontSize=17;fontFamily=Arial;strokeWidth=2;fillColor=#eaf3fb;strokeColor=#547da5;" vertex="1" parent="1">
          <mxGeometry x="340" y="120" width="440" height="95" as="geometry" />
        </mxCell>
        <mxCell id="topology" value="&lt;b&gt;Define the target estate&lt;/b&gt;&lt;br&gt;Sites, nodes, OS, storage, NICs and IP plan&lt;br&gt;Optional SDN → dedicated design/setup path&lt;br&gt;Identity, witness, reserves and operations" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=14;fontSize=17;fontFamily=Arial;strokeWidth=2;fillColor=#eaf3fb;strokeColor=#547da5;" vertex="1" parent="1">
          <mxGeometry x="290" y="270" width="540" height="110" as="geometry" />
        </mxCell>
        <mxCell id="vmm" value="&lt;b&gt;VMM provisioning handoff&lt;/b&gt;&lt;br&gt;VMM owns the chosen host/fabric stages&lt;br&gt;Collect only or execute via qualified adapter" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=14;fontSize=17;fontFamily=Arial;strokeWidth=2;fillColor=#eaf3fb;strokeColor=#547da5;" vertex="1" parent="1">
          <mxGeometry x="25" y="455" width="340" height="140" as="geometry" />
        </mxCell>
        <mxCell id="toolkit" value="&lt;b&gt;Toolkit / external automation&lt;/b&gt;&lt;br&gt;OEM imaging or prepared-host configuration&lt;br&gt;Ansible / PowerShell / scoped Terraform / DSC" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=14;fontSize=17;fontFamily=Arial;strokeWidth=2;fillColor=#eaf3fb;strokeColor=#547da5;" vertex="1" parent="1">
          <mxGeometry x="390" y="455" width="340" height="140" as="geometry" />
        </mxCell>
        <mxCell id="manual" value="&lt;b&gt;Prepared hosts / manual handoff&lt;/b&gt;&lt;br&gt;Native tools, WAC or another owner&lt;br&gt;Adopt existing resources explicitly" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=14;fontSize=17;fontFamily=Arial;strokeWidth=2;fillColor=#eaf3fb;strokeColor=#547da5;" vertex="1" parent="1">
          <mxGeometry x="755" y="455" width="340" height="140" as="geometry" />
        </mxCell>
        <mxCell id="vmminputs" value="&lt;b&gt;VMM-specific collection&lt;/b&gt;&lt;br&gt;&lt;br&gt;BMC protocol + Run As references&lt;br&gt;SMBIOS UUID + PXE NIC/MAC&lt;br&gt;WDS/PXE + ADK/WinPE&lt;br&gt;Generalized VHDX + drivers&lt;br&gt;Physical computer profile&lt;br&gt;Host group, switches and IP pools" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=14;fontSize=17;fontFamily=Arial;strokeWidth=2;fillColor=#eaf3fb;strokeColor=#547da5;" vertex="1" parent="1">
          <mxGeometry x="25" y="630" width="340" height="230" as="geometry" />
        </mxCell>
        <mxCell id="toolinputs" value="&lt;b&gt;Adapter-specific collection&lt;/b&gt;&lt;br&gt;&lt;br&gt;Exact toolkit/module versions&lt;br&gt;Runner connectivity and identity&lt;br&gt;Media and boot-disk targets&lt;br&gt;Engine/stage ownership&lt;br&gt;Data schemas and secret references&lt;br&gt;Resume and evidence contracts" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=14;fontSize=17;fontFamily=Arial;strokeWidth=2;fillColor=#eaf3fb;strokeColor=#547da5;" vertex="1" parent="1">
          <mxGeometry x="390" y="630" width="340" height="230" as="geometry" />
        </mxCell>
        <mxCell id="manualinputs" value="&lt;b&gt;Operator handoff collection&lt;/b&gt;&lt;br&gt;&lt;br&gt;Full host and cluster worksheet&lt;br&gt;Existing-resource inventory&lt;br&gt;Ordered build/configuration steps&lt;br&gt;Dependencies and responsible teams&lt;br&gt;Validation commands/checklist&lt;br&gt;Open decisions and acceptance" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=14;fontSize=17;fontFamily=Arial;strokeWidth=2;fillColor=#eaf3fb;strokeColor=#547da5;" vertex="1" parent="1">
          <mxGeometry x="755" y="630" width="340" height="230" as="geometry" />
        </mxCell>
        <mxCell id="gate" value="&lt;b&gt;Readiness gate&lt;/b&gt;&lt;br&gt;Complete data and supported configuration?&lt;br&gt;No conflicting writers or accidental replacements?&lt;br&gt;Correct profile/image/adapter and validation evidence?" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=14;fontSize=17;fontFamily=Arial;strokeWidth=2;fillColor=#fff3d7;strokeColor=#bb8b32;" vertex="1" parent="1">
          <mxGeometry x="290" y="930" width="540" height="110" as="geometry" />
        </mxCell>
        <mxCell id="package" value="&lt;b&gt;Produce the selected deliverables&lt;/b&gt;&lt;br&gt;Design report + canonical project + environment YAML&lt;br&gt;VMM or toolkit adapter when qualified" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=14;fontSize=17;fontFamily=Arial;strokeWidth=2;fillColor=#e9f4ec;strokeColor=#518361;" vertex="1" parent="1">
          <mxGeometry x="290" y="1105" width="540" height="95" as="geometry" />
        </mxCell>
        <mxCell id="execution" value="&lt;b&gt;Optional execution outside the website&lt;/b&gt;&lt;br&gt;Preflight → selected stages → cluster validation&lt;br&gt;Return results; never mark an export as deployed" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=14;fontSize=17;fontFamily=Arial;strokeWidth=2;fillColor=#f0edf8;strokeColor=#8271a5;" vertex="1" parent="1">
