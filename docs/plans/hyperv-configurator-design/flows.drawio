        <mxCell id="reports" value="&lt;b&gt;Save and export the design&lt;/b&gt;&lt;br&gt;JSON project • Markdown/PDF reports&lt;br&gt;XLSX/CSV schedules • editable diagrams&lt;br&gt;Incomplete drafts are clearly marked" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=14;fontSize=17;fontFamily=Arial;strokeWidth=2;fillColor=#e9f4ec;strokeColor=#518361;" vertex="1" parent="1">
