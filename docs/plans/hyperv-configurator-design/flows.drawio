        <mxCell id="mgmt" value="&lt;b&gt;Management-plane design&lt;/b&gt;&lt;br&gt;&lt;br&gt;Capabilities, products and existing/new status&lt;br&gt;VMM, SCOM, SQL, WAC, Arc and Dell OME&lt;br&gt;Per-component placement and HA&lt;br&gt;OME: manual appliance deployment" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=14;fontSize=17;fontFamily=Arial;strokeWidth=2;fillColor=#eaf3fb;strokeColor=#547da5;" vertex="1" parent="1">
